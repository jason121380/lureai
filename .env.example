APP_HOST=127.0.0.1
APP_PORT=8765
APP_PROFILE=customer_service
ADMIN_TOKEN=請改成長且不可猜測的管理權杖
USER_USERNAME=designer
USER_PASSWORD=請改成至少8字的強密碼

# 進階覆寫；留在註解狀態時由 APP_PROFILE 自動選擇
# KNOWLEDGE_JSONL=/absolute/path/to/approved-knowledge.jsonl
# APP_DB_PATH=/absolute/path/to/knowledge.db

# OpenAI 相容模型，可留空使用離線抽取式回答
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
LLM_REASONING_EFFORT=low

# 每位使用者的月預算與成本換算；請按目前模型費率、會計匯率調整
LLM_INPUT_USD_PER_MILLION=0.20
LLM_CACHED_INPUT_USD_PER_MILLION=0.02
LLM_CACHE_WRITE_USD_PER_MILLION=0.25
LLM_OUTPUT_USD_PER_MILLION=1.20
USD_TO_TWD=32.5
MONTHLY_BUDGET_TWD=1000
