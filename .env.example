# 本機開發綁 127.0.0.1；容器部署不用設，Dockerfile 已預設 0.0.0.0
APP_HOST=127.0.0.1
APP_PORT=8765
APP_PROFILE=designer_coach
# 僅供 X-Admin-Token 管理 API（curl／測試／緊急）；未設定時自動改用隨機權杖（後台仍走管理者帳號登入）
ADMIN_TOKEN=請改成長且不可猜測的管理權杖
# lurebot 呼叫 /api/bot/* 用的服務權杖；未設定就等於關閉機器人 API
BOT_API_TOKEN=
USER_USERNAME=designer
USER_PASSWORD=請改成至少4字的密碼
# 首個帳號的權限：user（一般用戶）或 admin（管理者，可用帳號登入管理後台）
USER_ROLE=user
# 每位使用者每分鐘可送出的聊天訊息數
CHAT_RATE_LIMIT_PER_MINUTE=20

# 進階覆寫；留在註解狀態時由 APP_PROFILE 自動選擇
# KNOWLEDGE_JSONL=/absolute/path/to/approved-knowledge.jsonl
# APP_DB_PATH=/absolute/path/to/knowledge.db

# OpenAI 相容模型，可留空使用離線抽取式回答
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
LLM_REASONING_EFFORT=low
# 模型生成逾時秒數；推理模型建議 60 以上，太短會頻繁降級為抽取式回答
LLM_TIMEOUT_SECONDS=60
# 單次回答的輸出 token 上限；留空＝不設上限（推理 token 也算在內，設太低會截斷答案）
# LLM_MAX_OUTPUT_TOKENS=4000

# 每位使用者的月預算與成本換算；費率已對齊 OpenAI 官方 gpt-5.6-luna 定價
# （2026-08 查核：input $0.20/M、cached input $0.02/M、output $1.20/M；
#   官方價若調整，改這裡即可，程式不用動）
LLM_INPUT_USD_PER_MILLION=0.20
LLM_CACHED_INPUT_USD_PER_MILLION=0.02
LLM_CACHE_WRITE_USD_PER_MILLION=0.25
LLM_OUTPUT_USD_PER_MILLION=1.20
USD_TO_TWD=32.5
MONTHLY_BUDGET_TWD=1000
